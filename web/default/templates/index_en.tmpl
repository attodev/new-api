    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>AlRouter — Unified AI API Gateway</title>
    <meta name="title" content="AlRouter — Unified AI API Gateway" />
    <meta name="description" content="One API for OpenAI, Claude, Gemini, and more. Simplify your enterprise AI stack with AlRouter." />
    <meta name="keywords" content="alrouter, AlRouter, AI API gateway, unified AI API, AI cost management, OpenAI API, Claude API, Gemini API, multi-provider AI, AI usage monitoring, enterprise AI" />
    <link rel="canonical" href="https://alrouter.ai/en" />

    <!-- hreflang -->
    <link rel="alternate" hreflang="en" href="https://alrouter.ai/en" />
    <link rel="alternate" hreflang="ko" href="https://alrouter.ai/" />
    <link rel="alternate" hreflang="x-default" href="https://alrouter.ai/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://alrouter.ai/en" />
    <meta property="og:title" content="AlRouter — Unified AI API Gateway" />
    <meta property="og:description" content="One API for OpenAI, Claude, Gemini, and more. Simplify your enterprise AI stack with AlRouter." />
    <meta property="og:image" content="https://alrouter.ai/og-image.png" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ko_KR" />
    <meta property="og:site_name" content="AlRouter" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="AlRouter — Unified AI API Gateway" />
    <meta name="twitter:description" content="One API for OpenAI, Claude, Gemini, and more. Cost reduction, usage control, team governance." />
    <meta name="twitter:image" content="https://alrouter.ai/og-image.png" />

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "AlRouter",
      "alternateName": ["알라우터", "alrouter"],
      "description": "Unified AI API gateway supporting OpenAI, Claude, Gemini and more. Cost reduction, usage monitoring, and team governance in one platform.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "url": "https://alrouter.ai",
      "inLanguage": ["en", "ko"],
      "offers": {
        "@type": "Offer",
        "priceCurrency": "KRW",
        "description": "Usage-based pricing, up to 10% below list price"
      },
      "provider": {
        "@type": "Organization",
        "name": "Atto Research",
        "url": "https://alrouter.ai"
      },
      "featureList": [
        "Unified AI API management",
        "Usage monitoring",
        "Budget control",
        "Team permission management",
        "OpenAI, Claude, Gemini support"
      ]
    }
    </script>

    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <script src="/lucide.min.js"></script>
    <link rel="stylesheet" href="/landing.css" />
  </head>
  <body>
    <!-- ── SECTION 1: GNB ── -->
    {{template "header_en" .}}

    <!-- ── SECTION 2: HERO ── -->
    <div style="padding: 0">
      <div class="hero">
        <div class="hero-left">
          <div class="hero-badge">
            <i data-lucide="sparkles"></i> ATTO Research LLM Gateway
          </div>
          <h1>Struggling with<br>AI Costs <span class="highlight">Out of Control?</span></h1>
          <p class="hero-sub">OpenAI, Claude, Gemini — a separate contract for every model,<br>
        budgets blowing past limits, no visibility into who's spending what.<br><br>
        Consolidate everything with AlRouter and<br>
        save <strong style="color:#EC4899">up to 10%</strong> off official prices.</p>
          <div class="hero-cta">
            <a href="/sign-in" class="btn-hero-primary">Get Started →</a>
            <button
              class="btn-hero-secondary"
              onclick="
                document.getElementById('contactOverlay').classList.add('open')
              "
            >
              Contact Sales
            </button>
          </div>
          <div class="hero-stats">
            <div class="stat-item">
              <div class="stat-value">10%</div>
              <div class="stat-label">Max Cost Savings</div>
            </div>
            <div class="stat-item">
              <div class="stat-value">$0</div>
              <div class="stat-label">Monthly Fee</div>
            </div>
            <div class="stat-item">
              <div class="stat-value">1</div>
              <div class="stat-label">API Key for Everything</div>
            </div>
          </div>
        </div>
        <div class="hero-right">
          <div
            class="billing-before"
            style="display: flex; justify-content: center; align-items: center"
          >
            <div class="anim-wrap" id="anim">
              <video
                id="animVideo"
                src="/videos/main/alrouter_en.mp4"
                playsinline
                preload="auto"
              ></video>
              <img id="animPosterImg" class="anim-poster-img" src="/videos/main/alrouter_en_poster.png" alt="AlRouter AI API Gateway service introduction video thumbnail" />
              <div class="anim-hover-overlay" id="animHoverOverlay">
                <div class="anim-hover-state" id="animPauseState">
                  <div class="anim-play-btn">
                    <div class="anim-pause-icon">
                      <span></span><span></span>
                    </div>
                  </div>
                  <span class="anim-play-label">Pause</span>
                </div>
                <div
                  class="anim-hover-state"
                  id="animResumeState"
                  style="display: none"
                >
                  <div class="anim-play-btn">
                    <svg
                      viewBox="0 0 24 24"
                      fill="white"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <polygon points="6,3 20,12 6,21" />
                    </svg>
                  </div>
                  <span class="anim-play-label">Continue</span>
                </div>
              </div>
              <div class="anim-play-overlay" id="animPlayOverlay">
                <div class="anim-play-btn">
                  <svg
                    viewBox="0 0 24 24"
                    fill="white"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <polygon points="6,3 20,12 6,21" />
                  </svg>
                </div>
                <span class="anim-play-label">Tap to Start</span>
              </div>
              <div class="anim-cta-wrap" id="animCtaWrap" style="display: none">
                <a href="/sign-in" class="anim-cta-overlay" id="animCtaBtn">
                  <img src="/logo.svg" alt="AlRouter" class="anim-cta-logo" />
                  <div class="anim-cta-btn-text">Get Started →</div>
                </a>
                <button
                  class="anim-end-btn anim-end-replay"
                  id="animReplayBtn"
                  style="display: none"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="white"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <polyline points="1 4 1 10 7 10" />
                    <path d="M3.51 15a9 9 0 1 0 .49-4" />
                  </svg>
                  Watch Again
                </button>
              </div>
            </div>
          </div>
          <div class="video-indicator">
            <button
              class="video-dot"
              id="dotStd"
              aria-label="Watch standard video"
              onclick="switchVideo('std')"
            ></button>
            <button
              class="video-dot active"
              id="dotLite"
              aria-label="Watch lite video"
              onclick="switchVideo('lite')"
            ></button>
          </div>
        </div>
      </div>
    </div>

    <!-- ── SECTION 4: PROBLEM ── -->
    <div class="section" id="about">
      <span class="section-tag">Pain Points</span>
      <h2>Does This Sound Familiar?</h2>
      <p class="section-sub">Did AI adoption end up increasing costs and complexity? Every team faces the same struggle.</p>
      <div class="problem-grid">
        <div class="problem-card">
          <div class="problem-card-header">
            <div class="problem-icon"><i data-lucide="banknote"></i></div>
            <h3>Separate Contracts, Separate Bills for Every AI Service</h3>
          </div>
          <p>ChatGPT from OpenAI, images from Gemini, coding from Claude... With every department subscribing separately, nobody knows the total AI spend.</p>
        </div>
        <div class="problem-card">
          <div class="problem-card-header">
            <div class="problem-icon"><i data-lucide="trending-up"></i></div>
            <h3>Cost Overruns Only Discovered at Month End</h3>
          </div>
          <p>There's no real-time visibility into who used which model and how much. You only react after the invoice arrives.</p>
        </div>
        <div class="problem-card">
          <div class="problem-card-header">
            <div class="problem-icon"><i data-lucide="siren"></i></div>
            <h3>Every Model, Every Person, Requests Never End</h3>
          </div>
          <p>GPT keys, Claude permissions, Gemini accounts... one more model, one more place to manage.</p>
          <p style="margin-top: 8px">More AI, more requests — admins never know where to start.</p>
        </div>
      </div>
    </div>

