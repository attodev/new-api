# fork: O13 — Open WebUI 결합 테스트 스택 설정 예시
# cp .env.example .env 후 값을 채운다. 비밀값은 `openssl rand -base64 36` 등으로 만든다.

# 브라우저와 Open WebUI 컨테이너가 모두 new-api 에 닿을 수 있는 호스트 이름 (IP 가 아닌 이름 권장).
#  - LAN 에서 바로 쓰려면 nip.io: 예) 192-168-0-10.nip.io  (→ 192.168.0.10 으로 풀림, 추가 설정 불필요)
#  - 사내 DNS 이름이 있으면 그 이름
#  - 오프라인이면 newapi.local 같은 이름 + 브라우저 머신 /etc/hosts + compose 의 extra_hosts 주석 해제
PUBLIC_HOST=192-168-0-10.nip.io
NEW_API_PORT=3000
OPEN_WEBUI_PORT=8080
TZ=Asia/Seoul

# new-api 이미지 태그. `docker compose up -d --build new-api` 가 저장소 루트 Dockerfile 로 이 이름의 이미지를 만든다.
# 다른 곳에서 빌드해 옮긴 이미지를 쓰면 그 태그를 적는다 (README 1절).
NEW_API_IMAGE=new-api-owui:latest
# Open WebUI 이미지. 문서 검증 기준 v0.11.4. 가능하면 태그를 고정한다.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# ---- DB / 캐시 ----
PG_USER=newapi
PG_PASSWORD=change-me-pg
PG_DB=newapi
REDIS_PASSWORD=change-me-redis

# ---- new-api 프로세스 비밀 (32바이트 이상, 노드 간 동일) ----
NEW_API_SESSION_SECRET=change-me-32-bytes-or-more-session-secret
NEW_API_CRYPTO_SECRET=change-me-32-bytes-or-more-crypto-secret
NEW_API_DEBUG=false

# ---- bootstrap.sh 가 new-api 에 만드는 계정 ----
# 비밀번호는 8~128자(develop 계정 비밀번호 규칙). 루트 이름은 최대 12자(초기 설정 API), 그 밖의 사용자 이름은 최대 20자.
# 루트 계정에 2단계 인증·패스키를 켜면 bootstrap 의 비밀번호 로그인이 추가 확인에서 멈추므로 시험 스택에서는 켜지 않는다.
NEW_API_ROOT_USER=root
NEW_API_ROOT_PASSWORD=change-me-root-pass
# 루트에 이메일을 주면 루트로도 Open WebUI 에 로그인할 수 있다(이메일을 넣는 관리 API 가 없어 psql 로 넣는다).
# 단, 관리자·루트는 relay 자동 연결 대상이 아니다. 로그인 뒤 사용자 편집 → "Open WebUI 연결" 에서 수동 연결하거나
# 아래 OWUI_MANUAL_LINKS 로 bootstrap 이 연결하게 해야 모델이 보인다.
NEW_API_ROOT_EMAIL=
NEW_API_SERVICE_USER=owui-svc
NEW_API_SERVICE_PASSWORD=change-me-svc-pass
# 테스트 사용자 (쉼표 구분 "아이디:비밀번호:이메일"). 비워 두면 만들지 않는다. 일반 사용자(역할 1)로 만든다.
NEW_API_TEST_USERS=alice:change-me-alice-pass:alice@example.com,bob:change-me-bob-pass:bob@example.com

# ---- Open WebUI ↔ new-api 공유 비밀 ----
OIDC_CLIENT_ID=openwebui
# 16자 이상 (oauth2.client_secret 검증)
OIDC_CLIENT_SECRET=change-me-client-secret-16-plus
# 32자 이상 (openwebui.jwt_secret 검증, 앞뒤 공백 제외)
OWUI_JWT_SECRET=change-me-jwt-secret-32-bytes-or-more-random
OWUI_SECRET_KEY=change-me-openwebui-session-key
# bootstrap.sh 가 채운다 (서비스 토큰 키). 직접 넣지 않는다.
OWUI_SERVICE_KEY=

# ---- 선택 ----
OWUI_GROUP_MANAGEMENT=false
OWUI_EMBEDDING_MODEL=text-embedding-3-small
# JWT 없이 서비스 키로만 온 요청(임베딩 등 사용자 맥락이 없는 호출)을 서비스 토큰으로 청구할지.
# true 면 서비스 토큰(owui-svc 지갑)에 청구하고 로그에 owui_unsigned 를 남긴다. false 면 401 로 거부한다.
OWUI_ALLOW_UNSIGNED=true
# 관리자·루트 등 자동 연결되지 않는 계정을 bootstrap 이 수동 연결한다 (쉼표 구분 "new-api 사용자 이름:Open WebUI sub").
# sub 는 Open WebUI 첫 로그인 뒤 new-api 로그 "openwebui: rejected (403) link_failed: privileged_user | sub=..." 에서 얻는다.
# 연결은 step-up 증명(admin.user.update)이 필요하므로 bootstrap 이 루트 비밀번호로 POST /api/verify 를 먼저 부른다.
OWUI_MANUAL_LINKS=
# 1 이면 bootstrap.sh 가 mock-upstream 채널(모델 mock-gpt)과 가격, 테스트 사용자 잔액을 넣는다. compose 는 --profile mock 으로 띄운다.
MOCK_UPSTREAM=0
