# 端口号
# PORT=3000
# 前端基础URL
# FRONTEND_BASE_URL=https://your-frontend-url.com
# Google Analytics 4 测量 ID
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# Google Tag Manager 容器 ID
# GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX


# 调试相关配置
# 启用pprof
# ENABLE_PPROF=true
# 启用调试模式
# DEBUG=true
# Pyroscope 配置
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=new-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# 数据库相关配置
# 启用错误日志记录
# ERROR_LOG_ENABLED=true
# 数据库连接字符串
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# 日志数据库连接字符串
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=100
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=1000
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60


# 缓存相关配置
# Redis连接字符串
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 渠道更新频率（单位：秒）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新启用
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5

# 任务和功能配置
# 更新任务启用
# UPDATE_TASK=true

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
# RELAY_TIMEOUT=0
# 流模式无响应超时时间，单位秒，如果出现空补全可以尝试改为更大值
# STREAMING_TIMEOUT=300

# TLS / HTTP 跳过验证设置
# TLS_INSECURE_SKIP_VERIFY=false

# Gemini 识别图片 最大图片数量
# GEMINI_VISION_MAX_IMAGE_NUM=16

# 会话密钥
# SESSION_SECRET=random_string
# 장기 결제 자격증명 암호화 키. 신규 설치는 SESSION_SECRET과 분리한
# 32바이트 이상의 영구 랜덤 값을 모든 노드에 동일하게 설정하세요.
# 기존 설치가 CRYPTO_SECRET 없이 SESSION_SECRET로 Toss 빌링키를 암호화했다면
# CRYPTO_SECRET을 계속 비워두거나 기존 SESSION_SECRET과 정확히 같은 값으로 설정하세요.
# 기존 키가 32바이트 미만이면 이 버전은 새 결제 작업을 거부합니다.
# DB 암호문을 기존 키로 복호화하고 새 32바이트 이상 키로 재암호화하는
# 별도 이전 작업 없이 키만 바꾸지 마세요. DB 백업과 암호화 키 백업을 함께 관리하세요.
# 다른 값을 도입/변경하면 기존 빌링키, pending 결제 복구 자격증명,
# enc:v1 옵션을 복호화할 수 없으며 별도의 재암호화 마이그레이션 없이 변경하면 안 됩니다.
# CRYPTO_SECRET=
# Toss 密钥加密迁移开关：先冻结 Toss 配置修改，升级所有节点，
# 确认所有节点使用相同且与旧密文匹配的持久 CRYPTO_SECRET（或 SESSION_SECRET），
# 然后再在所有节点启用。混合版本期间不要修改 Toss 密钥或测试/生产模式。
# NODE_TYPE=slave 노드는 DB migration을 수행하지 않으므로, 먼저 master 노드의
# 스키마 마이그레이션이 완료된 후 slave 노드와 새 결제 트래픽을 시작하세요.
# TOSS_OPTION_SECRET_ENCRYPTION_ENABLED=false
# 이 버전부터 provider POST 전에 DB의 14개 Toss 옵션, HMAC revision marker,
# 메모리 snapshot이 모두 일치해야 합니다. 롤링 배포 중에는 Toss 결제를 끄고
# 구버전 API/worker 노드를 먼저 drain하세요. 교체 후 세 결제 enable flag를 모두
# false로 둔 채 새 bulk 설정 API로 14개 옵션 전체를 한 번 재저장한 다음 다시
# 활성화하세요. revision 없는 구버전 쓰기/부분 restore는 quarantine되며 전체
# 재저장 전에는 신규 결제가 차단됩니다. 모든 노드는 같은 영구 CRYPTO_SECRET
# (또는 기존의 32바이트 이상 SESSION_SECRET)을 사용해야 합니다.
# 일반 결제 confirm은 기본적으로 paymentKey 범위 멱등키를 사용합니다. 아래
# false는 구버전 노드와 함께 배포할 때만 쓰는 임시 롤링 업그레이드 예외입니다.
# 먼저 checkout을 중지한 상태에서 false로 dual-reader 버전을 모든 노드에 배포하세요.
# 이후 신규 Toss checkout을 중지하고 기존 protocol-v0 pending 주문이 provider
# reconciliation/승인창 만료 cleanup으로 0건이 된 것을 확인한 뒤, 모든 노드에
# true를 적용하고 checkout을 재개하세요. v0 주문은 이후에도 영구히 legacy
# orderId 멱등키를 쓰며, true에서 생성된 v1 주문은 환경값과 무관하게 저장된
# paymentKey-scoped 프로토콜을 따릅니다. 구버전 바이너리가 남아 있을 때 v1을
# 생성하면 같은 주문을 서로 다른 멱등키로 confirm할 수 있습니다.
# 신규 설치/롤아웃 완료 환경에서는 변수를 생략하거나 true로 설정하세요. 잘못된
# 값도 보안을 위해 true로 처리되며, 명시적인 false만 legacy 신규 생성을 허용합니다.
# TOSS_PAYMENT_KEY_SCOPED_IDEMPOTENCY_ENABLED=true
# Toss 정기결제/지갑 자동충전 attempt 프로토콜 업그레이드는 구버전 master와
# 동시에 charge worker를 실행하는 롤링 배포가 아닙니다. 배포 전에 DB 옵션
# TossBillingEnabled=false와 TossWalletAutoRechargeEnabled=false를 둘 다 명시적으로
# 저장해 신규 billing POST를 중지하고 모든 구버전 master/
# scheduler 및 billing callback 트래픽을 완전히 중지한 뒤 최소 5분을 기다리세요.
# legacy 스키마에서 이 옵션이 켜져 있거나 값이 잘못되어 있으면 새 master는
# 아래 승인값과 무관하게 migration을 거부합니다.
# 이 drain 동안 Toss 키/MID, TossTestMode, 프로세스 TZ를 변경하지 말고 모든
# master가 기존 worker와 같은 TZ를 쓰는지 확인하세요. 그 다음 새 master
# 하나에만 TOSS_RECURRING_PROTOCOL_MIGRATION_DRAINED=true를 일시 설정하세요. 이
# legacy schema drain 승인은 schema migration 직후 opaque orderId v2 활성화에도
# 재사용되며, 두 DB 옵션 중 하나라도 명시적 false가 아니면 활성화되지 않습니다. 이는
# 활성 고객 계약을 해지하는 대신 모든 구버전 worker/callback 중지와 drain 완료를
# 명시적으로 확인하는 값입니다. schema migration 성공 즉시 제거하고, 재시도 시에는
# drain 조건을 다시 확인해야 하며, 이후 구버전 바이너리를 다시 시작하면 안 됩니다.
# schema migration을 완료하고 모든 노드를 새 버전으로 교체한 뒤, pending
# recurring attempt의 provider 조회/수동 reconciliation이 끝났는지 확인하세요.
# 마지막에 TossBillingEnabled를 다시 켜고, 별도 신규 옵션인
# TossWalletAutoRechargeEnabled는 그 이후에만 명시적으로 true로 설정하세요.
# 구버전 wallet worker는 이 신규 gate를 모르므로 구버전 master 중지만이 안전합니다.
# TOSS_RECURRING_PROTOCOL_MIGRATION_DRAINED=false
# 이미 Phase-A schema migration을 끝내 v1 singleton을 사용하는 DB는 동일한 drain
# 절차와 두 옵션의 명시적 false를 다시 확인한 뒤, sole migration master 하나에만
# TOSS_RECURRING_ORDER_ID_V2_ACTIVATION_DRAINED=true를 일시 설정해 재시작하세요.
# 성공 즉시 제거하고 구버전 바이너리를 다시 시작하지 마세요. 신규 DB는 v2로 시작합니다.
# TOSS_RECURRING_ORDER_ID_V2_ACTIVATION_DRAINED=false
# Toss API 버전은 요청 헤더가 아니라 MID별 개발자센터 설정을 따릅니다.
# 테스트/라이브 MID의 버전이 서로 다를 수 있으므로 결제를 활성화하기 전에 두
# 환경 모두 현재 코어 API Payment 필드/오류 형식과 맞는지 별도로 확인하세요.
# 아웃바운드 방화벽을 사용하면 api.tosspayments.com의 공식 8개 IP를 모두 허용하세요:
# 103.182.251.2, 103.182.250.2, 210.98.141.21, 210.98.141.22,
# 164.124.119.201, 121.67.39.201, 18.98.133.64, 18.98.133.65
# (마지막 4개는 2026년 5월 추가). DNS 대상은 이후에도 바뀔 수 있으므로 배포 전
# https://docs.tosspayments.com/reference/using-api/security 의 최신 목록을 다시 확인하세요.
# Toss 일반 웹훅은 서명이 없으므로 모든 이벤트를 공식 인바운드 IP에서만 처리합니다.
# 새 공식 IP를 앱 업데이트 전에 추가해야 하면 CIDR/IP를 쉼표로 구분해 지정하세요.
# TOSS_WEBHOOK_SOURCE_CIDRS=
# 역방향 프록시가 Toss의 직접 IP를 숨긴다면 해당 프록시 CIDR을 반드시 명시하세요.
# 목록에 든 프록시만 X-Forwarded-For를 제공할 수 있습니다.
# TOSS_WEBHOOK_TRUSTED_PROXY_CIDRS=

# 其他配置
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=false
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true

# LinuxDo相关配置
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master

# 可信任重定向域名列表（逗号分隔，支持子域名匹配）
# 用于验证支付成功/取消回调URL的域名安全性
# 示例: example.com,myapp.io 将允许 example.com, sub.example.com, myapp.io 等
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io
